    "    all_aggregate_stats.append(aggregate_stats)\n",
    "\n",
    "    mu = pct_alpha + np.sum(pct_betas * aggregate_stats['home_aggregate']['player_aggregate_pct']) - np.sum(pct_betas * aggregate_stats['away_aggregate']['player_aggregate_pct'])\n",
    "    sigma = pct_sigma\n",
