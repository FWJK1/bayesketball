    "years = np.arange(2010, 2024)\n",
    "player_counts = []\n",
    "for year in years:\n",
    "    year_stats = pd.read_csv(f'../data/player_stats_csv/{year}_{year+1}.csv')\n",
    "    team_ids = list(set(year_stats['TEAM_ID']))\n",
    "    for team_id in team_ids:\n",
    "        team_players = year_stats[year_stats['TEAM_ID'] == team_id]\n",
    "        player_counts.append(len(team_players))\n",
    "print(min(player_counts))"
   ]
